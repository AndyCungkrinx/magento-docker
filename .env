
#########################################
# Varnish
#########################################
varnish_size=100M
varnish_cpus_limit=0.4
varnish_memory_limit=400M
varnish_cpus_request=0.2
varnish_memory_request=200M

#########################################
# PHP
#########################################
source_dir=./www/magento2
php_cpus_limit=2
php_memory_limit=4096M
php_cpu_request=1
php_memory_request=2048M

#########################################
# Nginx
#########################################
source_dir=./www/magento2
nginx_cpus_limit=0.4
nginx_memory_limit=400M
nginx_cpu_request=0.2
nginx_memory_request=200M

##########################################
# Elasticsearch
##########################################
elasticsearch_cpus_limit=1
elasticsearch_memory_limit=2048M
elasticsearch_cpu_request=0.5
elasticsearch_memory_request=1024M

